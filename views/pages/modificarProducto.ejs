<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../secciones/head'); %>
</head>
<body class="d-flex flex-column min-vh-100">
    <main>
        <div class="container">
            <%- include('../secciones/menu'); %>
            <h1>Catálogo de productos</h1>
            <p>UT de San Juan</p>

            <div class="row mt-5">
                <div class="col-2"></div>
                <div class="col-8">
                    <form action="/modificarProducto" method="POST">
                        <% productos.forEach((prod) => { %>
                            <div class="card">
                                <div class="card-header">
                                    <h2>Modificar Producto</h2>   
                                </div>
                                <div class="card-body">
                                    <input type="text" class="form-control"
                                        readonly name="idProducto" id="idProducto"
                                        value="<%= prod.idProducto %>" />
                                    <br />

                                    <input type="text" class="form-control"
                                        name="nombreProducto" id="nombreProducto"
                                        value="<%= prod.nombreProducto %>"
                                        placeholder="Nombre del Producto" required />
                                    <br />

                                    <input type="text" class="form-control"
                                        name="marcaProducto" id="marcaProducto"
                                        value="<%= prod.marcaProducto %>"
                                        placeholder="Marca del Producto" required />
                                    <br />

                                    <input type="number" step="0.01" class="form-control"
                                        name="precioProducto" id="precioProducto"
                                        value="<%= prod.precioProducto %>"
                                        placeholder="Precio del Producto" required />
                                </div>
                                <div class="card-footer">
                                    <a class="btn btn-secondary" href="/listaProductos">
                                        Cancelar
                                    </a>     
                                    <button type="submit" class="btn btn-primary">
                                        Guardar producto 
                                    </button>           
                                </div>
                            </div>
                        <% }); %>
                    </form>
                </div>
                <div class="col-2"></div>
            </div>
        </div>
    </main>

    <footer class="footer mt-auto py-3 bg-light">
        <%- include('../secciones/footer'); %>
    </footer>
</body>
</html>